# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# === DATABASE (PostgreSQL — used on Render) ===
# Render provides a DATABASE_URL; map it to DB_URL in your service env vars.
DB_URL=jdbc:postgresql://localhost:5432/foodrescue_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# === JWT ===
# Must be at least 32 characters long and kept secret.
JWT_SECRET=YourLongRandomSecretKeyHereMakeItAtLeast32CharactersLong

# === CORS ===
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example for Render static site:
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# === SERVER PORT ===
# Render sets PORT automatically (usually 10000). Leave as-is.
# PORT=10000
